{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "strict",
      "hidden": true,
      "description": "CI quality gate: every warning is an error",
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    },
    {
      "name": "benchmarks",
      "hidden": true,
      "description": "Release build with the nanobench benchmarks",
      "cacheVariables": {
        "CENGINE_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "X_VCPKG_APPLOCAL_DEPS_INSTALL": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "msvc",
      "hidden": true,
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "clang-cl",
      "hidden": true,
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "unix",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "unix",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": "unix",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "inherits": [
        "msvc",
        "debug"
      ]
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "inherits": [
        "msvc",
        "release"
      ]
    },
    {
      "name": "msvc-bench",
      "displayName": "MSVC benchmarks",
      "inherits": [
        "msvc",
        "release",
        "benchmarks"
      ]
    },
    {
      "name": "clang-cl-debug",
      "displayName": "clang-cl Debug",
      "inherits": [
        "clang-cl",
        "debug"
      ]
    },
    {
      "name": "clang-cl-release",
      "displayName": "clang-cl Release",
      "inherits": [
        "clang-cl",
        "release"
      ]
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "inherits": [
        "gcc",
        "debug"
      ]
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "inherits": [
        "gcc",
        "release"
      ]
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "inherits": [
        "clang",
        "debug"
      ]
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "inherits": [
        "clang",
        "release"
      ]
    },
    {
      "name": "clang-bench",
      "displayName": "Clang benchmarks",
      "inherits": [
        "clang",
        "release",
        "benchmarks"
      ]
    },
    {
      "name": "gcc-bench",
      "displayName": "GCC benchmarks",
      "inherits": [
        "gcc",
        "release",
        "benchmarks"
      ]
    },
    {
      "name": "ci-msvc",
      "displayName": "CI: MSVC Release (static)",
      "inherits": [
        "msvc",
        "release",
        "strict"
      ]
    },
    {
      "name": "ci-msvc-shared",
      "displayName": "CI: MSVC Release (shared)",
      "inherits": [
        "msvc",
        "release",
        "strict"
      ],
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "ci-gcc",
      "displayName": "CI: GCC Release (+ benchmark smoke)",
      "inherits": [
        "gcc",
        "release",
        "strict",
        "benchmarks"
      ]
    },
    {
      "name": "ci-gcc-float",
      "displayName": "CI: GCC Release, float precision",
      "inherits": [
        "gcc",
        "release",
        "strict"
      ],
      "cacheVariables": {
        "CENGINE_DOUBLE_PRECISION": "OFF"
      }
    },
    {
      "name": "ci-clang",
      "displayName": "CI: Clang Release",
      "inherits": [
        "clang",
        "release",
        "strict"
      ]
    },
    {
      "name": "ci-tidy",
      "displayName": "CI: clang-tidy",
      "inherits": [
        "clang",
        "debug",
        "strict"
      ],
      "cacheVariables": {
        "CENGINE_ENABLE_CLANG_TIDY": "ON",
        "CENGINE_BUILD_PACKAGE_TEST": "OFF"
      }
    },
    {
      "name": "ci-coverage",
      "displayName": "CI: GCC coverage",
      "inherits": [
        "gcc",
        "debug"
      ],
      "cacheVariables": {
        "CENGINE_ENABLE_COVERAGE": "ON",
        "CENGINE_BUILD_PACKAGE_TEST": "OFF"
      }
    },
    {
      "name": "docs",
      "displayName": "Documentation only (no compiler deps, no vcpkg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CENGINE_BUILD_DOCS": "ON",
        "CENGINE_BUILD_TESTS": "OFF",
        "CENGINE_BUILD_APPS": "ON",
        "CENGINE_DOCS_WARN_AS_ERROR": "ON"
      }
    }
  ],
