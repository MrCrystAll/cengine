#pragma once

/// @file
/// @brief Build configuration of @PROJECT_NAME@ (generated by CMake). See ADR 0008 and ADR 0009.

#include <limits>

namespace @PROJECT_NAME@ {

/// @brief True when the engine was built with `CENGINE_DOUBLE_PRECISION=ON` (the default).
inline constexpr bool double_precision = @CENGINE_DOUBLE_PRECISION_CPP@;

/// @brief Engine-wide floating-point scalar: `double` or `float`, chosen at build time.
///
/// Use it for every scalar in engine code. Write literals as `static_cast<real>(0.1)`.
using real = @CENGINE_REAL_TYPE@;

static_assert(std::numeric_limits<real>::is_iec559,
              "@PROJECT_NAME@ requires IEEE 754 floating point (ADR 0009)");

} // namespace @PROJECT_NAME@
