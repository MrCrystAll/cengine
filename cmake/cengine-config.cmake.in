# CMake package config for @PROJECT_NAME@ @PROJECT_VERSION@
#
#   find_package(@PROJECT_NAME@ CONFIG REQUIRED)                  # every installed module
#   find_package(@PROJECT_NAME@ CONFIG REQUIRED COMPONENTS core)  # only what you need
#   target_link_libraries(my_target PRIVATE @PROJECT_NAME@::core)

@PACKAGE_INIT@

# Build configuration of this package (ADR 0008).
set(@PROJECT_NAME@_DOUBLE_PRECISION @CENGINE_DOUBLE_PRECISION@)

set(_@PROJECT_NAME@_known_modules "@CENGINE_ALL_MODULES@")

if(@PROJECT_NAME@_FIND_COMPONENTS)
  set(_@PROJECT_NAME@_wanted ${@PROJECT_NAME@_FIND_COMPONENTS})
else()
  set(_@PROJECT_NAME@_wanted ${_@PROJECT_NAME@_known_modules})
endif()

foreach(_comp IN LISTS _@PROJECT_NAME@_wanted)
  set(_file "${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@_${_comp}-module.cmake")
  if(EXISTS "${_file}")
    include("${_file}")
    set(@PROJECT_NAME@_${_comp}_FOUND TRUE)
  else()
    set(@PROJECT_NAME@_${_comp}_FOUND FALSE)
  endif()
endforeach()
unset(_file)
unset(_comp)
unset(_@PROJECT_NAME@_wanted)

check_required_components(@PROJECT_NAME@)
